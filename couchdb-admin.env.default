COUCHDB_USER=admin
COUCHDB_PASSWORD=changeme
# Pin this to any long random string, e.g. the output of `openssl rand -hex 32`.
# CouchDB 3.x generates a random one at every start if it is unset, which
# invalidates every login cookie each time the container restarts.
COUCHDB_SECRET=change-me-to-a-long-random-string
